PORT=5000
NODE_ENV=development
# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
# Leave empty to use the built-in JSON file store (backend/data/db.json). Set to use MongoDB.
MONGODB_URI=
CORS_ORIGIN=http://localhost:5173
# Password assigned to all seeded demo accounts
DEMO_PASSWORD=Demo@123
# simulated | razorpay
PAYMENT_GATEWAY=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shared secret GPS devices send in the x-device-key header
GPS_DEVICE_KEY=demo-gps-device-key
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
